{
  "profile_version": 2,
  "account": "REPLACE_WITH_NEW_ACCOUNT",
  "profile_dir": "D:\\workspace\\agent-help\\x-starter\\.browser-executor-profile",

  "rationale": "Values set after a suspension on 2026-11-14. The previous run used a 7 second median between reposts and pushed 1914 writes in 45 hours; this profile is deliberately far below every measured ceiling.",

  "runtime": {
    "nav_timeout_ms": 45000,
    "headless": true,
    "persistent": true
  },

  "circuit_breaker": {
    "stop_on_any_refusal": true,
    "refusal_codes": ["283", "161", "141", "37"],
    "stop_on_uncertain_streak": 2,
    "cooldown_hours_after_refusal": 24,
    "cooldown_hours_after_uncertain_streak": 4,
    "do_not_switch_action_kind": true
  },

  "follow": {
    "enabled": true,
    "per_day": 25,
    "min_gap_seconds": 90,
    "max_gap_seconds": 240,
    "per_window": 10,
    "window_seconds": 900,
    "on_429": "wait_reset_epoch",
    "on_code_161": "stop_today",
    "probe_interval_minutes": 240
  },

  "repost": {
    "enabled": true,
    "per_day": 40,
    "per_wave": 2,
    "min_gap_seconds": 120,
    "max_gap_seconds": 300,
    "require_timeline_visit_between_waves": true
  },

  "like": {
    "enabled": true,
    "per_day": 60,
    "per_wave": 3,
    "min_gap_seconds": 60,
    "max_gap_seconds": 180,
    "disabled_reason": null
  },

  "warmup": {
    "required_days_before_automation": 7,
    "required_original_posts": 10,
    "required_profile_fields": ["name", "bio", "avatar"],
    "reason": "An account with no followers and no original posts has no standing to absorb interaction writes."
  },

  "pool": {
    "replenish_below": 40,
    "per_harvest": 120
  },

  "success_states": ["following", "liked", "reposted", "replied"],
  "failure_codes_that_are_definite": ["X_WRITE_REJECTED"],
  "failure_codes_that_wait": ["X_RATE_LIMITED"],
  "failure_codes_that_stop_the_day": ["141", "37", "283", "161"]
}
